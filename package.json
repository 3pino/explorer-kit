{
  "name": "@3pino/explorer-kit",
  "version": "0.1.0",
  "description": "ファイルエクスプローラーの共有の部品（disnans・disrect）。Svelte 5 の部品と、その決まり・状態",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "svelte": "./src/index.ts", "default": "./src/index.ts" },
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["src", "!src/**/*.test.ts", "!src/test-support"],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.53.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@3pino/design-system": "git+https://github.com/3pino/design-system.git#v0.4.1",
    "@lucide/svelte": "^1.53.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
